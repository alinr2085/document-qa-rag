# Copy to .env and fill in OPENROUTER_API_KEY
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Any model from https://openrouter.ai/collections/free-models (ids ending in :free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Oracle (used by docker compose; ORACLE_USER/PASSWORD are shared by the DB container and Django)
ORACLE_SYS_PASSWORD=SysPass123
ORACLE_USER=docqa
ORACLE_PASSWORD=docqa_pass
ORACLE_SERVICE=FREEPDB1

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@example.com

# true = API requires login (session/Basic auth)
API_REQUIRE_AUTH=false

# Optional RAG tuning
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_QUERY_REWRITE=false
